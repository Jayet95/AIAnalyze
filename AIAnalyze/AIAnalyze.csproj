<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-AIAnalyze-12a33555-39e4-4d59-b81d-6acb1f15dc32</UserSecretsId>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- File identity shown in Properties > Details and read by antivirus reputation checks. -->
    <Product>AIAnalyze</Product>
    <AssemblyTitle>AIAnalyze PC Diagnostics</AssemblyTitle>
    <Description>Local PC diagnostics: checks system health, samples CPU and GPU sensors, records FPS, and explains problems.</Description>
    <Company>AIAnalyze</Company>
    <Copyright>Copyright © 2026 AIAnalyze</Copyright>
    <Version>0.5.0</Version>
    <FileVersion>0.5.0.0</FileVersion>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Local web UI served by the service on 127.0.0.1. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.1.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.15" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>
</Project>
